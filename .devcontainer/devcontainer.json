{
  "name": "Laravel MVC Lab",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",

  "features": {},

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "onecentlin.laravel-blade",
        "ryannaddy.laravel-artisan",
        "mikestead.dotenv"
      ],
      "settings": {
        "php.validate.executablePath": "/usr/local/bin/php"
      }
    }
  },

  "forwardPorts": [8000, 5173, 3306, 8080],
  "portsAttributes": {
    "8000": { "label": "Laravel (php artisan serve)" },
    "5173": { "label": "Vite dev server" },
    "3306": { "label": "MySQL" },
    "8080": { "label": "phpMyAdmin" }
  },

  "postCreateCommand": "php -v && composer -V && node -v",

  "remoteUser": "root"
}
